# luvhub configuration. Copy to .env (Docker) or .env.local (npm run dev) and fill in.
# Locally everything is optional: `npm run dev` starts without any of these.

# Public address of this app. Lovable previews and OAuth callbacks need https in production.
APP_URL=http://localhost:3000

# Session encryption key, at least 32 characters: openssl rand -base64 32
# Required in production; in development a temporary one is used when empty.
SESSION_SECRET=

# --- Lovable: OAuth (one-click login for everyone) ...
LOVABLE_CLIENT_ID=
LOVABLE_CLIENT_SECRET=
LOVABLE_AUTHORIZE_URL=
LOVABLE_TOKEN_URL=
# ... or a workspace API key shared by all users of this server.
LOVABLE_API_KEY=

# --- HubSpot: OAuth app (one-click login, scopes: oauth content files) ...
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# ... or a private app token for a single portal.
HUBSPOT_ACCESS_TOKEN=

# Hosts the renderer may open (comma separated, wildcards allowed).
# RENDER_ALLOWED_HOSTS=*.lovable.app,*.lovableproject.com,*.lovable.dev

# --- GitHub: keeps HubSpot in sync with Lovable through a GitHub Action.
# OAuth app (github.com/settings/developers), callback: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ... or one token for a single team (fine-grained: Contents, Workflows, Secrets, Actions read/write).
LUVHUB_GITHUB_TOKEN=
# The Action the generated workflow uses; pin a release tag in production.
# LUVHUB_ACTION_REF=GS-Loft-Dev/luvhub@main
